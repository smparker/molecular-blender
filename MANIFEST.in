# Include source files needed for building from sdist
include README.md
include AUTHORS
include COPYING
include setup.py
include pyproject.toml
# cibuildwheel runs this standalone test from both checkouts and sdists.
include test/test_wheel.py test/installed_esp.py
include test/fixtures/wavefunction_esp/water.dat

# Include Cython source files
recursive-include molecular_blender *.pyx
recursive-include molecular_blender *.pxd

# Regenerate Cython C++ against the target Python and NumPy headers.
global-exclude *.cpp

# Include Python files
recursive-include molecular_blender *.py

# Include data files if any
recursive-include molecular_blender *.json

# Exclude build artifacts
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.so
global-exclude *.o
global-exclude __pycache__
prune build
prune dist
prune *.egg-info

# Exclude setup utilities (not needed in wheels)
prune _setuputils

# Exclude examples and tests
prune examples
include examples/water_esp/water.molden
prune util
exclude test.py
exclude run_test.sh
exclude marching_profile.py

